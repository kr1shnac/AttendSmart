# ============================================
# AttendSmart Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# DATABASE (REQUIRED)
# ============================================
# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Clusters → Connect
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/attendsmart?retryWrites=true&w=majority

# ============================================
# AUTHENTICATION (REQUIRED)
# ============================================
# Secret key for JWT signing - use a strong random string (32+ chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secure-jwt-secret-change-this-in-production

# Token expiration time
JWT_EXPIRY=7d

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development

# Frontend URL for CORS configuration
# In production, set this to your actual frontend domain
FRONTEND_URL=http://localhost:3000

# Session secret for express-session
SESSION_SECRET=your-session-secret-change-in-production

# ============================================
# CACHING (OPTIONAL - Falls back to in-memory)
# ============================================
# Redis URL for caching and job queues
# Local: redis://localhost:6379
# Upstash: rediss://default:password@host:port
REDIS_URL=redis://localhost:6379

# ============================================
# BIOMETRIC SERVICES (OPTIONAL)
# ============================================
# Face recognition engine URL
FACE_ENGINE_URL=http://localhost:5050

# Minimum confidence threshold for face matching (0.0 - 1.0)
FACE_CONFIDENCE_THRESHOLD=0.6

# ============================================
# ADMIN CREDENTIALS (OPTIONAL)
# ============================================
# Admin username for environment-based login
ADMIN_USERNAME=admin

# Bcrypt hash of admin password
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=$2a$10$xxxxxxxxxxxxx

# ============================================
# SECURITY (PRODUCTION ONLY)
# ============================================
# Maximum login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# Lockout duration in milliseconds (15 minutes)
LOCKOUT_DURATION=900000

# ============================================
# CAMPUS SETTINGS (OPTIONAL)
# ============================================
# Default campus coordinates for GPS verification
CAMPUS_LATITUDE=12.9716
CAMPUS_LONGITUDE=77.5946
CAMPUS_RADIUS=500
